{
  "name": "ascend-backend",
  "version": "0.0.1.9.3",
  "description": "Backend Node.js pour Ascend - Conversion AsciiDoc ⇄ Markdown",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "eslint \"scripts/**/*.js\"",
    "lint:full": "eslint \"**/*.js\" --ignore-pattern \"node_modules/**\" --ignore-pattern \"logs/**\" --ignore-pattern \"tmp/**\"",
    "test:smoke": "node scripts/smoke-api.js",
    "test:golden": "node scripts/verify-golden-corpus.js",
    "test:roundtrip": "node scripts/verify-roundtrip-adoc-md.js",
    "test:capacity": "node scripts/verify-capacity-profile.js",
    "test:admonitions": "node scripts/verify-admonition-conversion.js",
    "test:precision": "node scripts/verify-conversion-precision.js",
    "test:text2markdown-result": "node scripts/verify-text2markdown-result.js",
    "test:proxy-failure-classify": "node scripts/verify-proxy-failure-classify.js",
    "test:pandoc-result": "node scripts/verify-pandoc-result.js",
    "test:html-wrappers": "node scripts/verify-html-wrappers.js",
    "test:metrics": "node scripts/verify-conversion-metrics.js",
    "test:from-html-failure": "node scripts/verify-e2e-from-html-failure-contract.js",
    "test:from-markdown-failure": "node scripts/verify-e2e-from-markdown-failure-contract.js",
    "test:from-text-failure": "node scripts/verify-e2e-from-text-failure-contract.js"
  },
  "keywords": [
    "asciidoc",
    "markdown",
    "converter"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "eslint": "^8.57.1"
  }
}
