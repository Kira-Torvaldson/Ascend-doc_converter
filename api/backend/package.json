{
  "name": "ascend-backend",
  "version": "0.0.1.4.4",
  "description": "Backend Node.js pour Ascend - Conversion AsciiDoc ⇄ Markdown",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "eslint \"scripts/**/*.js\"",
    "lint:full": "eslint \"**/*.js\" --ignore-pattern \"node_modules/**\" --ignore-pattern \"logs/**\" --ignore-pattern \"tmp/**\"",
    "test:smoke": "node scripts/smoke-api.js"
  },
  "keywords": [
    "asciidoc",
    "markdown",
    "converter"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "eslint": "^8.57.1"
  }
}
