{
  "name": "downdoc",
  "version": "1.0.2-stable",
  "description": "Rapidly down-converts AsciiDoc to Markdown. Often used to prepare an AsciiDoc README for npm packaging.",
  "license": "MIT",
  "author": "Dan Allen",
  "contributors": [
    "Dan Allen <dan@opendevise.com>"
  ],
  "repository": "https://github.com/opendevise/downdoc",
  "bugs": {
    "url": "https://github.com/opendevise/downdoc/issues"
  },
  "engines": {
    "node": ">=16.17.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:front\" \"npm run dev:back\"",
    "dev:all": "concurrently \"npm run dev:front\" \"npm run dev:back\"",
    "dev:front": "npm --prefix api/frontend run dev",
    "dev:back": "npm --prefix api/backend run dev",
    "check:front": "npm --prefix api/frontend run typecheck && npm --prefix api/frontend run lint && npm --prefix api/frontend run test && npm --prefix api/frontend run build",
    "check:back": "npm --prefix api/backend run lint && npm --prefix api/backend run test:smoke",
    "check": "npm run check:front && npm run check:back",
    "coverage": "nyc _mocha",
    "build": "npm test && npm run lint",
    "format": "node npm/format.js lib,test,npm",
    "lint": "eslint \"{lib,test,npm}/**/*.js\"",
    "postpublish": "downdoc --postpublish",
    "prepublishOnly": "downdoc --prepublish",
    "test": "_mocha",
    "version": "node npm/version.js"
  },
  "bin": {
    "downdoc": "bin/downdoc"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "imports": {
    "#cli": "./lib/cli.js"
  },
  "files": [
    "lib"
  ],
  "workspaces": [
    "."
  ],
  "keywords": [
    "asciidoc",
    "markdown",
    "converter"
  ],
  "devDependencies": {
    "concurrently": "^9.1.0",
    "chai": "~4.3",
    "chai-fs": "~2.0",
    "chai-string": "~1.5",
    "dirty-chai": "~2.0",
    "eslint": "~8.45",
    "eslint-config-standard": "~17.1",
    "mocha": "^10.8.2",
    "nyc": "~15.1",
    "prettier-eslint": "~15.0"
  },
  "nyc": {
    "all": true,
    "branches": 100,
    "cacheDir": "node_modules/.cache/nyc",
    "checkCoverage": true,
    "include": [
      "lib/**/*.js"
    ],
    "lines": 100,
    "reporter": [
      "cobertura",
      "lcov",
      "text"
    ],
    "reportDir": "reports"
  }
}
