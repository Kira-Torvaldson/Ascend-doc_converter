server {
  listen 80;
  server_name _;

  # Strict CSP: no inline scripts. Keep styles permissive to avoid breaking
  # React inline styles and existing UI (no domain hardcoding).
  add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:;" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header X-Frame-Options "DENY" always;

  # Static SPA files (built by Vite)
  root /usr/share/nginx/html;
  index index.html;

  # Allow larger payloads if needed (envsubst-compatible).
  client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

  # SPA fallback routing
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Reverse proxy to backend
  location /api/ {
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-API-Key "${API_KEY}";

    proxy_pass http://backend:3003;
  }

  # Static assets served by backend (e.g. /public/rafale.jpg)
  location /public/ {
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_pass http://backend:3003;
  }
}

