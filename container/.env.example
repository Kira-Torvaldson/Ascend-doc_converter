#
# Ascend container stack (production-oriented)
# Copy to .env then fill in as needed.
#

# Public HTTP port for the nginx frontend container
FRONTEND_HTTP_PORT=

# Optional: planned for future TLS/ACME automation (not hardcoded anywhere)
DOMAIN=
DOMAIN_ALT=
ACME_EMAIL=

# Backend API protection (in production, Nginx injects this header to backend)
API_KEY=

# Backend runtime paths inside the container (mounted as named volumes)
LOGS_DIR=
TMPDIR=

# Nginx tuning (slightly above backend MAX_INPUT_SIZE_MB default 5)
NGINX_CLIENT_MAX_BODY_SIZE=

# Backend conversion limits (optional overrides)
MAX_INPUT_SIZE_MB=
CONVERSION_TIMEOUT_MS=

